# Copy this file to .env and fill in the values. .env is gitignored and never committed.
#
# Point the app at a Postgres you control. With the Docker database below, this is it:
CHAINLENS_DATABASE_URL=postgresql+psycopg://chainlens:chainlens@localhost:5432/chainlens

# Your Gemini key, from https://aistudio.google.com (Get API key). With this set, answers
# are written by Gemini 2.5 Flash instead of being quoted straight from the contract.
CHAINLENS_GOOGLE_API_KEY=

# Leave this unset when using the Docker/managed database above. Set it to 1 only to use
# the built-in embedded Postgres (the one your antivirus was blocking).
# CHAINLENS_LOCAL_PG=1
