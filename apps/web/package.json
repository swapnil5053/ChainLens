{
  "name": "chainlens-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "smoke": "esbuild test/smoke.ts --bundle --platform=node --format=esm --outfile=test/smoke.mjs --log-level=error && node test/smoke.mjs",
    "verify": "npm run typecheck && npm run smoke && npm run build && npm run design:build",
    "fixtures": "python3 ../../scripts/build_web_fixtures.py",
    "design": "impeccable detect src",
    "design:build": "impeccable detect dist"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.62.0",
    "@tanstack/react-virtual": "^3.11.0",
    "motion": "^12.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "@types/node": "^22.0.0",
    "impeccable": "^3.5.0"
  }
}
