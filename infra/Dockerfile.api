FROM python:3.12-slim AS base

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /srv

RUN apt-get update \
 && apt-get install -y --no-install-recommends curl \
 && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml ./
COPY apps/api ./apps/api
COPY eval ./eval
COPY scripts ./scripts

RUN pip install --upgrade pip && pip install .

ENV PYTHONPATH=/srv/apps/api:/srv

# The image runs as a non-root user; the runtime directory is the only writable path.
RUN useradd --create-home --uid 10001 chainlens \
 && mkdir -p /srv/var && chown -R chainlens:chainlens /srv/var
USER chainlens

EXPOSE 8000
HEALTHCHECK --interval=10s --timeout=3s --retries=12 \
  CMD curl -fsS http://localhost:8000/health || exit 1

CMD ["uvicorn", "chainlens.main:app", "--host", "0.0.0.0", "--port", "8000"]
